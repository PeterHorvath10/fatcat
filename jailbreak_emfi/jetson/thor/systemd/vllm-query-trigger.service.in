[Unit]
Description=TCP-triggered vLLM query worker (inference-time EMFI trials)
After=network-online.target
Wants=network-online.target
# One owner of the trial port at a time.
Conflicts=vllm-reload-trigger.service gpu-memfault.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@PAPER_CODE@
Environment=HOME=@HOME@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@PAPER_CODE@
ExecStart=@PYTHON@ -m jetson.thor.vllm_query_trigger
Restart=always
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=multi-user.target
